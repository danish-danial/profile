---
import { Font } from "astro:assets";
import BirdGathering from "../components/BirdGathering.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Danish Danial",
    description = "iOS apps, Python tools and notes by Danish Danial.",
} = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
    <head>
        <Font cssVariable="--font-lexend" preload />
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <title>{title === "Danish Danial" ? title : `${title} | Danish Danial`}</title>
    </head>
    <body>
        <a class="skip" href="#main">Skip to content</a>
        <header class="site-header">
            <div class="page-width">
                {isHome ? (
                    <h1 class="wordmark">Danish Danial</h1>
                ) : (
                    <a class="wordmark" href="/" aria-label="Danish Danial, home">Danish Danial</a>
                )}
            </div>
        </header>
        <main id="main" tabindex="-1">
            <slot />
        </main>
        <footer class="site-footer">
            <nav class="page-width" aria-label="Contact">
                <a href="mailto:danishdanialzurkanain@gmail.com">Email</a>
                <a href="https://github.com/danish-danial">GitHub</a>
            </nav>
            <BirdGathering />
        </footer>
    </body>
</html>

<style is:global>
    @import "../styles/global.css";
</style>
